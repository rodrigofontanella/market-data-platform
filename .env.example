# PostgreSQL container
POSTGRES_DB=market_data
POSTGRES_USER=market_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

# Database connection used by applications running locally
DATABASE_URL=postgresql+psycopg://market_user:change-me@localhost:5433/market_data

# Database connection used inside Docker
DOCKER_DATABASE_URL=postgresql+psycopg://market_user:change-me@postgres:5432/market_data

# Kafka ports
KAFKA_EXTERNAL_PORT=29092
KAFKA_INTERNAL_PORT=9092
KAFKA_CONTROLLER_PORT=9093

# Kafka connection used by applications running locally
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Kafka connection used inside Docker
DOCKER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka application settings
KAFKA_TOPIC=market.trades.raw
KAFKA_GROUP_ID=market-trades-storage-v1

# Producer
PRODUCER_INTERVAL_SECONDS=1.0

# API
API_HOST_PORT=8000

# Kafka UI
KAFKA_UI_HOST_PORT=8080
